# PostgreSQL connection string from Neon (use pooled URL for runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/quickfix?sslmode=require"
# Direct Neon connection for Prisma migrations (recommended)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/quickfix?sslmode=require"

# Admin bootstrap login. Generate with: node scripts/hash-password.mjs 'your-long-unique-password'
ADMIN_USERNAME="owner"
ADMIN_PASSWORD_HASH=""
# Generate a base32 TOTP secret and configure it in an authenticator app. Never commit real values.
ADMIN_TOTP_SECRET=""
# Generate 32+ random bytes. Used to sign short-lived admin sessions.
SESSION_SECRET=""

# Set after deploying, e.g. https://quickfix.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_BUSINESS_PHONE="+91 96612 88308"
NEXT_PUBLIC_WHATSAPP_NUMBER="919661288308"
NEXT_PUBLIC_BUSINESS_ADDRESS="Patna, Bihar"

# Optional admin product-image uploads (Cloudinary). Keep API secret server-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
